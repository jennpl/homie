# Shared development database. Exchange this secret outside Git.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Each developer selects an isolated seeded household.
# Tony: tony-test | Partner: partner-test | Integration: shared-demo
HOMIE_HOUSEHOLD_ID=tony-test

# Protects the backend-only manual endpoints.
HOMIE_INTERNAL_API_KEY=replace-with-a-long-random-value

# Required by the organizer, but not by Twilio adapter tests.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
